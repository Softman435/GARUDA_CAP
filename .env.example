# Copy this file to ".env" and change only what you need. Every line is optional for local use.
# (scripts\install.bat creates .env for you.) Never put real secrets in this example file, and never commit ".env".

APP_ENV=development                 # "development" or "production"
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR   (log file: data\logs\garuda.log)

# Upload and processing limits
MAX_UPLOAD_MB=2048
MAX_DURATION_SECONDS=10800
MAX_CONCURRENT_JOBS=1
RATE_LIMIT_PER_MINUTE=120

# Speech recognition (runs locally on your computer; no paid service, nothing is uploaded)
# Defaults are chosen for a laptop CPU with 16 GB RAM and NO NVIDIA graphics card.
WHISPER_MODEL=base                  # tiny | base | small | medium | large-v3   (start with base, try small for better Kannada)
WHISPER_DEVICE=cpu                  # cpu | cuda  (cuda needs an NVIDIA card; if it is missing the app falls back to cpu)
WHISPER_COMPUTE_TYPE=int8           # int8 is best for CPU (checked against what is installed)
WHISPER_CPU_THREADS=0               # 0 = automatic. Try 4 if the computer feels slow while transcribing.
WHISPER_BEAM_SIZE=5                 # 1 = fastest, 5 = most accurate (slower)
WHISPER_IDLE_RELEASE_SECONDS=300    # free the model's memory after this many idle seconds (0 = keep it loaded)
AUDIO_NORMALIZE=true                # level the volume of the extracted audio before recognition
ALLOW_MODEL_DOWNLOAD=true           # false = never use the internet (the model must already be in the model folder)
# Your OWN fine-tuned model (a folder in faster-whisper/CTranslate2 format, or a Hugging Face repo id). See training\README.md.
# CUSTOM_MODEL=data\models\my-kannada-ct2
# IndicConformer (AI4Bharat .nemo file): copy the file to data\models\indic and run scripts\setup_indic.bat (see docs\INDIC_CONFORMER.md).
# Normally nothing below needs to be set: the setup script writes data\indic_runner.txt for you.
# INDIC_MODEL=data\models\indic\indicconformer_stt_kn_hybrid_rnnt_large.nemo
# INDIC_DECODER=rnnt                  # rnnt (recommended) | ctc
# INDIC_TIMEOUT_MINUTES=180
# Better Kannada: choose the model "kn-medium" (Kannada-tuned, downloads once) in the app. See docs\KANNADA_ACCURACY.md.
# Optional names/terms for Whisper to expect: create the file data\vocabulary.txt (one per line).
# WHISPER_MODEL_DIR=C:\garuda-models   # default: the "data\models" folder inside this project

# Storage
# GARUDA_DATA_DIR=C:\garuda-data
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/garuda   # leave empty to use local SQLite

# Production only (required when APP_ENV=production): a long random value, e.g. from
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=
